---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Louiml' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta
      name="description"
      content="Louiml. Systems and frontend work in Rust, C++, and TypeScript. Currently building Ryuzaki."
    />
  </head>
  <body>
    <slot />
  </body>
</html>
