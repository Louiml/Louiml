---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page does not exist." noindex>
  <section class="container wrap">
    <p class="mono-label">404</p>
    <h1>Page Not Found</h1>
    <p class="lede">The page you’re looking for doesn’t exist or has moved.</p>
    <a class="home" href="/">Back to the Home Page <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: 8rem;
  }

  .wrap h1 {
    margin-top: 1rem;
  }

  .lede {
    margin-top: 1rem;
    color: var(--muted);
  }

  .home {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--accent);
  }

  .home:hover,
  .home:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
