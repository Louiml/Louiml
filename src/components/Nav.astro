---
const links = [
  { label: 'About', href: '#about' },
  { label: 'Project', href: '#project' },
  { label: 'Connect', href: '#connect' },
];
---

<header class="nav" data-reveal>
  <div class="nav-inner glass">
    <a href="#top" class="brand" aria-label="Louiml, home">
      <span class="dot" aria-hidden="true"></span>Louiml
    </a>
    <nav aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a href="#connect" class="nav-cta">Get in touch</a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 14px 0 auto 0;
    z-index: 50;
    pointer-events: none;
  }
  .nav-inner {
    pointer-events: auto;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 7px 7px 7px 18px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 8px;
    width: calc(100% - 28px);
    max-width: min(var(--maxw), calc(100vw - 28px));
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }
  nav { display: flex; gap: 2px; }
  nav a {
    padding: 8px 13px;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-2);
    transition: color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }
  nav a:hover { color: var(--text); background: var(--bg-raise-2); }
  .nav-cta {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--text);
    color: var(--bg);
  }
  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    width: 38px; height: 38px;
    flex-direction: column;
    gap: 5px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .nav-toggle span {
    width: 16px; height: 1.6px;
    background: var(--text);
    border-radius: 2px;
  }

  /* Compact: hide inline links, show toggle. Menu opens below the pill. */
  @media (max-width: 640px) {
    nav, .nav-cta { display: none; }
    .nav-toggle { display: flex; }
    .nav.open nav {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      top: calc(100% + 8px);
      left: 0; right: 0;
      padding: 8px;
      gap: 2px;
    }
    .nav.open nav a {
      padding: 12px 14px;
      background: var(--bg-raise-2);
    }
    .nav.open .nav-cta {
      display: inline-flex;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
    }
  }
</style>

<script>
  const header = document.querySelector('.nav');
  const toggle = header?.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    if (!header) return;
    const open = header.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  // Close menu on navigation.
  header?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => header.classList.remove('open'))
  );
</script>
